# Copiar a .env (permisos 0600). NUNCA versionar el .env real.
# Secreto de la GUI / API RC de rclone
RC_USER=admin
RC_PASS=rclone123

# ─── Rutas base del plugin de docker (convención del servidor) ─────────────
# PATH_TO_APPDATA  → configuración de los servicios (rclone.conf, remotes)
# PATH_TO_DATA     → datos que guardan/generan las apps (archivos, montajes)
#
# En hpserver (test): valores en el .env del proyecto.
# En Lenovo/OMV (prod): variables globales OMV, apuntan al disco físico.
PATH_TO_APPDATA=/opt/data
PATH_TO_DATA=/opt/data