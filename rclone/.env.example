# Copiar a .env (permisos 0600). NUNCA versionar el .env real.
# Secreto de la GUI / API RC de rclone
RC_USER=admin
RC_PASS=rclone123

# Ruta base del host donde viven los datos de los servicios.
# En hpserver (test): valor en el .env del proyecto.
# En Lenovo/OMV (prod): variable global, apunta al disco físico (p. ej. /srv/dev-disk-...).
PATH_TO_DATA=/opt/data